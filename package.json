{
  "name": "surprise-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parametric 3D model of HMS Surprise (ex-French corvette Unite, 1794), lofted from her own 1798 Admiralty draught",
  "scripts": {
    "build": "node tools/build.js",
    "audit": "node tools/audit.js",
    "trace": "node tools/trace.js",
    "render": "node tools/render.js",
    "check": "node tools/make-specs.js && node tools/trace.js && node tools/audit.js && node tools/check-motion.js && node tools/build.js && node tools/verify-glb.js",
    "viewer": "node tools/serve.js",
    "site": "node tools/build-site.js",
    "verify": "node tools/verify-glb.js",
    "specs": "node tools/make-specs.js",
    "motion": "node tools/check-motion.js"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "three": "^0.180.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/britten-dev/surprise-model.git"
  },
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/ship/index.js",
    "./spec": "./src/spec/spec.js",
    "./hull": "./src/ship/hull.js",
    "./lod": "./src/ship/lod.js",
    "./views": "./viewer/views.js",
    "./package.json": "./package.json",
    "./motion": "./src/ship/motion.js",
    "./crew": "./src/ship/crew.js"
  },
  "files": [
    "src",
    "viewer/views.js",
    "SPECS.md",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "three": ">=0.180.0 <1"
  }
}
